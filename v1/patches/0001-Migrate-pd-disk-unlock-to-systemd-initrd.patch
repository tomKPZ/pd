From a39b4124d4bdf6ecb6382628c7ef1a55711f45a7 Mon Sep 17 00:00:00 2001
From: tomKPZ <tomKPZ@gmail.com>
Date: Sat, 24 Oct 2026 10:22:01 -0700
Subject: [PATCH 01/35] Migrate pd disk unlock to systemd initrd

---
 system/boot.nix | 35 ++++++++++++++++++++++++-----------
 1 file changed, 24 insertions(+), 11 deletions(-)

diff --git a/system/boot.nix b/system/boot.nix
index 693ba0c..6f62946 100644
--- a/system/boot.nix
+++ b/system/boot.nix
@@ -1,19 +1,32 @@
-{ ... }: {
+{ config, pkgs, ... }: {
   services.lvm.boot.thin.enable = true;
 
   boot = {
-    # Keep the script-based initrd for the custom disk-unlock hook below.
-    initrd.systemd.enable = false;
+    initrd.systemd.enable = true;
     initrd.luks.forceLuksSupportInInitrd = true;
 
-    initrd.preLVMCommands = ''
-      udevadm settle
-      dmsetup create dm-luks /boot_tmp/table.txt
-      rm -f /boot_tmp/disk
-      cryptsetup open --key-file=/boot_tmp/key.bin --keyfile-offset=64 --header=/boot_tmp/header.dat /dev/mapper/dm-luks luks
-      shred -u /boot_tmp/*
-      rmdir /boot_tmp
-    '';
+    # pd/late.sh appends /boot_tmp (including the key and detached header)
+    # to the initrd before kexec. Keep these files out of the Nix store.
+    initrd.systemd.services.pd-unlock = {
+      description = "Unlock the pd encrypted disk";
+      requiredBy = [ "initrd.target" ];
+      wants = [ "systemd-udev-settle.service" ];
+      after = [ "systemd-udev-settle.service" ];
+      before = [ "cryptsetup.target" "initrd-root-device.target" "initrd-root-fs.target" ];
+      unitConfig.DefaultDependencies = false;
+      serviceConfig = {
+        Type = "oneshot";
+        RemainAfterExit = true;
+      };
+      path = [ pkgs.coreutils pkgs.cryptsetup config.services.lvm.package ];
+      script = ''
+        dmsetup create dm-luks /boot_tmp/table.txt
+        rm -f /boot_tmp/disk
+        cryptsetup open --key-file=/boot_tmp/key.bin --keyfile-offset=64 --header=/boot_tmp/header.dat /dev/mapper/dm-luks luks
+        shred -u /boot_tmp/*
+        rmdir /boot_tmp
+      '';
+    };
     loader.grub = {
       enable = false;
     };
-- 
