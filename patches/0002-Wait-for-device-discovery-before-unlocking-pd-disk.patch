From 3cc144d9c224563cd79c12579ea776d363e9a707 Mon Sep 17 00:00:00 2001
From: tomKPZ <tomKPZ@gmail.com>
Date: Sat, 24 Oct 2026 10:27:28 -0700
Subject: [PATCH 02/35] Wait for device discovery before unlocking pd disk

---
 system/boot.nix | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/system/boot.nix b/system/boot.nix
index 6f62946..63d6d07 100644
--- a/system/boot.nix
+++ b/system/boot.nix
@@ -10,16 +10,20 @@
     initrd.systemd.services.pd-unlock = {
       description = "Unlock the pd encrypted disk";
       requiredBy = [ "initrd.target" ];
-      wants = [ "systemd-udev-settle.service" ];
-      after = [ "systemd-udev-settle.service" ];
+      wants = [ "systemd-udev-trigger.service" "systemd-modules-load.service" ];
+      after = [ "systemd-udev-trigger.service" "systemd-modules-load.service" ];
       before = [ "cryptsetup.target" "initrd-root-device.target" "initrd-root-fs.target" ];
       unitConfig.DefaultDependencies = false;
       serviceConfig = {
         Type = "oneshot";
         RemainAfterExit = true;
       };
-      path = [ pkgs.coreutils pkgs.cryptsetup config.services.lvm.package ];
+      path = [ pkgs.coreutils pkgs.cryptsetup config.services.lvm.package config.boot.initrd.systemd.package ];
       script = ''
+        # Coldplug must enqueue devices before settling. The table uses the
+        # /boot_tmp/disk symlink supplied by pd, whose target needs udev.
+        udevadm settle --timeout=60
+        test -b /boot_tmp/disk
         dmsetup create dm-luks /boot_tmp/table.txt
         rm -f /boot_tmp/disk
         cryptsetup open --key-file=/boot_tmp/key.bin --keyfile-offset=64 --header=/boot_tmp/header.dat /dev/mapper/dm-luks luks
-- 
